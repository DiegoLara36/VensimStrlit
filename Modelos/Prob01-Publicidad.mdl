{UTF-8}
Adquisicion por marketing=500
	~	
	~		|

Adquisicion Viral=Usuarios Activos * Tasa de Contacto * Fraccion de adopcion viral * \
		(Usuario Potenciales / Poblacion total del mercado )
	~	
	~		|

Efectividad de remarketing=0.05
	~	
	~		|

Flujo de Abandono=Usuarios Activos / Tiempo medio de retencion
	~	
	~		|

Flujo de Adquisicion=Adquisicion por marketing+Adquisicion Viral
	~	
	~		|

Flujo de Recuperacion=UsuariosInactivos * Efectividad de remarketing
	~	
	~		|

Fraccion de adopcion viral=0.02
	~	
	~		|

Poblacion total del mercado=Usuario Potenciales+Usuarios Activos+UsuariosInactivos
	~	
	~		|

Tasa de Contacto=5
	~	
	~		|

Tiempo medio de retencion=12
	~	
	~		|

Usuario Potenciales= INTEG (Flujo de Recuperacion-Flujo de Adquisicion,
		100000)
	~	
	~		|

Usuarios Activos= INTEG (Flujo de Adquisicion-Flujo de Abandono,
		0)
	~	
	~		|

UsuariosInactivos= INTEG (Flujo de Abandono-Flujo de Recuperacion,
		0)
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 60
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Month [0,?]
	~	The time step for the simulation.
	|

